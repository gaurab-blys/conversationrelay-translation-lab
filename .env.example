# Twilio credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Twilio Voice SDK (for browser agent UI)
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VOICE_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public URL (ngrok HTTPS) — no trailing slash
WEBHOOK_BASE_URL=https://xxxx.ngrok-free.app

# Translation provider (deepl | openai | stub)
TRANSLATION_PROVIDER=stub

# DeepL (if TRANSLATION_PROVIDER=deepl)
DEEPL_API_KEY=

# OpenAI (if TRANSLATION_PROVIDER=openai)
OPENAI_API_KEY=

# OpenAI performance tuning (only used when TRANSLATION_PROVIDER=openai)
# Use a smaller model here to reduce latency.
OPENAI_TRANSLATION_MODEL=gpt-5.6
# Keep small because this text is immediately converted to TTS.
OPENAI_MAX_OUTPUT_TOKENS=120

# Translate strategy for ConversationRelay prompts:
# - turn: buffer until prompt.last === true (current behavior)
# - segment: translate each prompt segment immediately (lower perceived latency)
TRANSLATE_MODE=turn

# Language config
CALLER_A_LANG=en-US
CALLER_B_LANG=hi-IN

# Server
PORT=4000
