# =============================================================================
# ConversationRelay Translation Lab — environment template
# Copy to .env and fill in secrets. Restart the server after changes.
#
# Many knobs trade LATENCY (how fast the other party hears translation) against
# ACCURACY (full meaning, correct wording, natural pronunciation).
#
# Quick presets:
#   Low latency  → TRANSLATE_MODE=segment, OPENAI_REASONING_EFFORT=minimal,
#                  TTS_ELEVENLABS_MODEL=flash_v2_5, ELEVENLABS_TEXT_NORMALIZATION=off
#   High accuracy → TRANSLATE_MODE=turn, OPENAI_MAX_OUTPUT_TOKENS=4000,
#                   OPENAI_REASONING_EFFORT=low, ELEVENLABS_TEXT_NORMALIZATION=on
# =============================================================================

# -----------------------------------------------------------------------------
# Twilio credentials
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Twilio Voice SDK (browser agent UI)
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VOICE_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public URL (ngrok HTTPS) — no trailing slash
WEBHOOK_BASE_URL=https://xxxx.ngrok-free.app

# -----------------------------------------------------------------------------
# Translation provider
# -----------------------------------------------------------------------------
# stub   = no API call (fastest; for plumbing tests only)
# openai = production path (gpt-5.x via Responses API)
# deepl  = alternative provider (not wired in all code paths)
TRANSLATION_PROVIDER=stub

DEEPL_API_KEY=

OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# OpenAI translation tuning  (TRANSLATION_PROVIDER=openai only)
# -----------------------------------------------------------------------------
# Model choice. Smaller/faster models ↓ latency, may ↓ nuance on long sentences.
# Tradeoff: faster model = lower latency | larger model = higher accuracy
OPENAI_TRANSLATION_MODEL=gpt-5.6

# Total token budget for each API call. On gpt-5.x this includes hidden
# "reasoning" tokens AND the visible translated text.
# Tradeoff: lower (400–800) = faster/cheaper but can truncate long utterances
#           higher (2000–4000) = fuller translations, slightly slower on retries
OPENAI_MAX_OUTPUT_TOKENS=2000

# How hard the model "thinks" before answering. Only applies to reasoning models.
# Values: minimal | low | medium | high
# Tradeoff: minimal/low = lower latency, less reasoning overhead
#           medium/high = better on complex sentences, much higher latency/cost
#           Too high + low MAX_OUTPUT_TOKENS → empty or 8-char translations
OPENAI_REASONING_EFFORT=low

# -----------------------------------------------------------------------------
# When to translate STT text (ConversationRelay prompt handling)
# -----------------------------------------------------------------------------
# turn    = wait until the speaker finishes (prompt.last=true), translate once.
#           ↑ accuracy (full sentence context)  ↓ latency (agent waits)
# segment = translate each STT chunk immediately, stream TTS with last:false
#           until the final chunk (last:true).
#           ↑ latency (agent hears sooner)  ↓ accuracy (partial context;
#           more API calls; glossary hits only on words in that chunk)
TRANSLATE_MODE=segment

# -----------------------------------------------------------------------------
# TTS delivery (ConversationRelay text → speech on the opposite leg)
# -----------------------------------------------------------------------------
# Max characters per TTS websocket token. Longer translations are split.
# Tradeoff: lower (180–220) = smaller chunks, safer for TTS providers,
#           but more websocket messages and slight playback stitching risk
#           higher (350–500) = fewer chunks, slightly faster end-to-end,
#           but some providers truncate very long tokens
TTS_TOKEN_MAX_CHARS=280

# Utterances queued when the opposite leg has not connected yet.
# Only affects connect-time race; not mid-call latency vs accuracy.
TTS_PENDING_MAX=30

# -----------------------------------------------------------------------------
# Language pairing
# Agent (browser) = leg A. Client (phone) = leg B.
# -----------------------------------------------------------------------------
CALLER_A_LANG=en-US
CALLER_B_LANG=hi-IN

# -----------------------------------------------------------------------------
# TTS voice / accent (what each role hears)
# Provider: ElevenLabs | Google | Amazon
# -----------------------------------------------------------------------------
TTS_PROVIDER=ElevenLabs

# Accent per leg. Agent = A, client phone = B.
# English: us | gb | au | in. Hindi: in. Spanish: es | us. French: fr | ca.
TTS_ACCENT_A=us
TTS_ACCENT_B=in
TTS_EN_ACCENT=us

# Optional explicit ElevenLabs voice IDs (override accent defaults)
# TTS_VOICE_A=
# TTS_VOICE_B=

# ElevenLabs model:
#   flash_v2_5  = lowest latency (recommended for live calls)
#   turbo_v2_5  = slightly richer voice, a bit slower
#   turbo_v2    = older turbo
# Tradeoff: flash = lower latency | turbo = slightly higher quality
TTS_ELEVENLABS_MODEL=flash_v2_5

# Speech rate. 1.0 = normal.
# Tradeoff: >1.0 = faster playback (lower perceived wait) | <1.0 = clearer pacing
TTS_ELEVENLABS_SPEED=1.0

# Voice consistency knobs (ElevenLabs). Usually leave defaults.
TTS_ELEVENLABS_STABILITY=0.6
TTS_ELEVENLABS_SIMILARITY=0.8

# Pronunciation normalization for numbers, dates, abbreviations.
# Tradeoff: on = higher pronunciation accuracy, slight extra TTS latency
#           off = lower latency, occasional mispronunciation of edge cases
#           auto = behaves like off on ConversationRelay
ELEVENLABS_TEXT_NORMALIZATION=on


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=4000
