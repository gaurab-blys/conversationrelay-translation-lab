# Twilio credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Twilio Voice SDK (for browser agent UI)
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VOICE_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public URL (ngrok HTTPS) — no trailing slash
WEBHOOK_BASE_URL=https://xxxx.ngrok-free.app

# Translation provider (deepl | openai | stub)
TRANSLATION_PROVIDER=stub

# DeepL (if TRANSLATION_PROVIDER=deepl)
DEEPL_API_KEY=

# OpenAI (if TRANSLATION_PROVIDER=openai)
OPENAI_API_KEY=

# OpenAI performance tuning (only used when TRANSLATION_PROVIDER=openai)
# Use a smaller model here to reduce latency.
OPENAI_TRANSLATION_MODEL=gpt-5.6
# Keep small because this text is immediately converted to TTS.
OPENAI_MAX_OUTPUT_TOKENS=120

# Translate strategy for ConversationRelay prompts:
# - turn: buffer until prompt.last === true (current behavior)
# - segment: translate each prompt segment immediately (lower perceived latency)
TRANSLATE_MODE=turn

# Language config
CALLER_A_LANG=en-US
CALLER_B_LANG=hi-IN

# ConversationRelay TTS (human-sounding voices + accent)
# Provider: ElevenLabs | Google | Amazon
TTS_PROVIDER=ElevenLabs
# Accent for TTS each role hears. Agent (browser) = A, client phone = B.
# English: us | gb | au | in. Hindi: in. Spanish: es | us. French: fr | ca.
TTS_ACCENT_A=us
TTS_ACCENT_B=in
# Legacy fallback if a role accent is omitted
TTS_EN_ACCENT=us
# Optional explicit ElevenLabs voice IDs for what each role hears
# TTS_VOICE_A=
# TTS_VOICE_B=
# ElevenLabs model: flash_v2_5 (lowest latency) | turbo_v2_5 | turbo_v2 | flash_v2
TTS_ELEVENLABS_MODEL=flash_v2_5
TTS_ELEVENLABS_SPEED=1.0
TTS_ELEVENLABS_STABILITY=0.6
TTS_ELEVENLABS_SIMILARITY=0.8
# on improves pronunciation (slight extra latency). auto behaves like off on ConversationRelay.
ELEVENLABS_TEXT_NORMALIZATION=on
# Optional explicit ElevenLabs voice IDs (overrides accent defaults)
# TTS_VOICE_EN=
# TTS_VOICE_HI=

# Server
PORT=4000
